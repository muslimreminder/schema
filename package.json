{
  "name": "@muslimreminder/schema",
  "version": "0.2.0",
  "description": "Shared Zod schemas and types for Muslim Reminder: published content (hadiths, Quran…) and API contracts.",
  "license": "MIT",
  "author": "Muslim Reminder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muslimreminder/schema.git"
  },
  "homepage": "https://github.com/muslimreminder/schema#readme",
  "bugs": "https://github.com/muslimreminder/schema/issues",
  "keywords": [
    "muslim-reminder",
    "zod",
    "schema",
    "hadith",
    "quran"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm run test && npm run build && npm run lint:package",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@11.19.0"
}
